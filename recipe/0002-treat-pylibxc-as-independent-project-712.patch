index 8195880f7..04c6dfd0c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -504,28 +504,7 @@ if(ENABLE_FORTRAN)
 endif()
 
 if(ENABLE_PYTHON)
-  set(SOURCE_PYTHON_API
-    pylibxc/__init__.py
-    pylibxc/array_backend.py
-    pylibxc/core.py
-    pylibxc/dlpack.py
-    pylibxc/flags.py
-    pylibxc/functional.py
-    pylibxc/structs.py
-    pylibxc/testing.py
